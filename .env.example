# ---- Vercel Server-Side Environment Variables (SECRET: do NOT prefix with VITE_) ----
GEMINI_API_KEY=your-google-gemini-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PAYSTACK_SECRET_KEY=sk_test_or_sk_live_your_paystack_secret_key
PAYSTACK_PRO_AMOUNT_KOBO=500000
PAYSTACK_CURRENCY=NGN
# Optional recurring Paystack subscription plan code:
# PAYSTACK_PLAN_CODE=PLN_xxxxxxxxx
PRO_MONTHLY_AI_SCANS=100

# Optional: set to "true" ONLY in Vercel Preview if you want Pro Preview uploads before Supabase is connected
DEV_ALLOW_PRO_PREVIEW=false

# ---- Vite Frontend Environment Variables (PUBLIC) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
